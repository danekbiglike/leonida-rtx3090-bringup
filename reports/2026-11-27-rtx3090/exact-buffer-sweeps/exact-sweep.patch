+++ b/crates/victory-gpu/src/shadow/exact_sweep.rs
@@ -0,0 +1,97 @@
+//! Idle eviction of exact buffer views. Keep the existing 512-request lifetime.
+//! Provenance: danekbiglike/rtx3090-20261127-exact-sweep.
+
+use std::collections::BTreeMap;
+
+const MIN_ENTRIES: usize = 256;
+const RECENT: u64 = 512;
+
+pub(super) struct Schedule {
+    checked_at: u64,
+    skip_for: u64,
+}
+
+impl Schedule {
+    pub(super) const fn new() -> Self {
+        Self { checked_at: 0, skip_for: 0 }
+    }
+
+    pub(super) fn prune<K, V>(
+        &mut self,
+        map: &mut BTreeMap<K, (V, u64)>,
+        now: u64,
+        allocation_failed: bool,
+        mut held_elsewhere: impl FnMut(&V) -> bool,
+    ) -> usize
+    where
+        K: Ord,
+    {
+        if !allocation_failed && (map.len() < MIN_ENTRIES || now.wrapping_sub(self.checked_at) < self.skip_for) {
+            return 0;
+        }
+        let before = map.len();
+        let mut until_eligible = RECENT;
+        map.retain(|_, (value, used)| {
+            let age = now.wrapping_sub(*used);
+            if age < RECENT {
+                until_eligible = until_eligible.min(RECENT - age);
+                return true;
+            }
+            let held = held_elsewhere(value);
+            if held {
+                // A list or slot can drop its reference at any time.
+                until_eligible = 0;
+            }
+            held
+        });
+        // Any later insertion or hit is newer than every entry inspected here.
+        self.checked_at = now;
+        self.skip_for = until_eligible;
+        before - map.len()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn recent_entries_keep_their_full_lifetime_without_an_owner_probe() {
+        let mut map: BTreeMap<_, _> = (0..256).map(|i| (i, ((), i))).collect();
+        let mut schedule = Schedule::new();
+        let never = |_: &()| panic!("a recent buffer was probed");
+        assert_eq!(schedule.prune(&mut map, 256, false, never), 0);
+        assert_eq!(schedule.skip_for, 256);
+        assert_eq!(schedule.prune(&mut map, 511, false, never), 0);
+        assert_eq!(schedule.prune(&mut map, 512, false, |_| false), 1);
+        assert!(!map.contains_key(&0));
+    }
+
+    #[test]
+    fn an_old_held_resource_is_checked_again_on_the_next_miss() {
+        let mut map: BTreeMap<_, _> = (0..256).map(|i| (i, (i, 900))).collect();
+        map.insert(0, (0, 0));
+        let mut schedule = Schedule::new();
+        let mut probed = vec![];
+        assert_eq!(schedule.prune(&mut map, 1000, false, |i| { probed.push(*i); true }), 0);
+        assert_eq!(schedule.prune(&mut map, 1001, false, |i| { probed.push(*i); false }), 1);
+        assert_eq!(probed, [0, 0]);
+    }
+
+    #[test]
+    fn allocation_failure_can_free_an_old_unheld_entry_in_a_small_cache() {
+        let mut map = BTreeMap::from([(1, (false, 0)), (2, (true, 0)), (3, (false, 511))]);
+        let mut schedule = Schedule::new();
+        assert_eq!(schedule.prune(&mut map, 512, false, |_| false), 0);
+        assert_eq!(schedule.prune(&mut map, 512, true, |held| *held), 1);
+        assert_eq!(map.keys().copied().collect::<Vec<_>>(), [2, 3]);
+    }
+
+    #[test]
+    fn the_recent_window_crosses_counter_wrap() {
+        let mut map = BTreeMap::from([(1, ((), u64::MAX - 255))]);
+        let mut schedule = Schedule::new();
+        assert_eq!(schedule.prune(&mut map, 255, true, |_| false), 0);
+        assert_eq!(schedule.prune(&mut map, 256, true, |_| false), 1);
+    }
+}
