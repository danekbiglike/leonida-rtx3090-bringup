+    // Replay the same two-minute key sequence used in the RTX 3090 escort benchmark.
+    fn escort_walk_down() -> bool {
+        use std::time::{SystemTime, UNIX_EPOCH};
+        static PATH: LazyLock<Option<std::path::PathBuf>> =
+            LazyLock::new(|| std::env::var_os("VICTORY_ESCORT_MARK").map(Into::into));
+        let Some(path) = PATH.as_ref() else { return false };
+        static TIMING: Mutex<(Option<Instant>, Option<u64>)> = Mutex::new((None, None));
+        let mut timing = TIMING.lock().unwrap_or_else(PoisonError::into_inner);
+        if timing.1.is_none() && timing.0.is_none_or(|t| t.elapsed() >= Duration::from_millis(250)) {
+            timing.0 = Some(Instant::now());
+            timing.1 = std::fs::read_to_string(path).ok().and_then(|v| v.trim().parse().ok());
+        }
+        let Some(start) = timing.1 else { return false };
+        let Ok(now) = SystemTime::now().duration_since(UNIX_EPOCH) else { return false };
+        let Some(t) = (now.as_millis() as u64).checked_sub(start) else { return false };
+        t < 120_000 && t % 550 < 350
+    }
