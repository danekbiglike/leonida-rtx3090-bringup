     /// Counts a presented frame.
     fn frame(&mut self, hwnd: HWND) {
+        if let Some((out, last, previous_draws)) = &mut self.present_log {
+            use std::io::Write;
+            let now = std::time::Instant::now();
+            let interval = now.duration_since(*last).as_micros();
+            let draws = crate::draw::drawn();
+            let utc = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_micros();
+            let written = writeln!(out, "{interval},{},{utc}", draws.saturating_sub(*previous_draws));
+            *last = now;
+            *previous_draws = draws;
+            if written.is_err() || (self.since.elapsed().as_secs() >= 1 && out.flush().is_err()) {
+                self.present_log = None;
+            }
+        }
