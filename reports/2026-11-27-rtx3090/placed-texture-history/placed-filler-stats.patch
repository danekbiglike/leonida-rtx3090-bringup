@@ -0,0 +1,88 @@
+//! Optional census of filler-only variants in placed texture descriptors.
+//! Set VICTORY_PLACED_FILLER_STATS=1 for a diagnostic run.
+//! Provenance: danekbiglike/rtx3090-20261127-placed-filler.
+
+use std::collections::BTreeSet;
+use std::sync::{Mutex, OnceLock};
+
+pub(crate) const MAX_KEYS: usize = 16_384;
+
+#[derive(Default)]
+struct History {
+    // Order by normalized texture first, then by the two discarded words.
+    keys: BTreeSet<(u64, [u32; 14], [u32; 2])>,
+    twins: usize,
+}
+
+impl History {
+    fn record(&mut self, address: u64, normalized: &[u32; 14], raw: &[u32; 14]) {
+        if self.keys.len() == MAX_KEYS || normalized == raw {
+            return;
+        }
+        let filler = [raw[1], raw[13]];
+        let group = (address, *normalized, [0; 2])..=(address, *normalized, [u32::MAX; 2]);
+        let has_variant = self.keys.range(group).next().is_some();
+        if self.keys.insert((address, *normalized, filler)) && has_variant {
+            self.twins += 1;
+        }
+    }
+}
+
+fn tracker() -> Option<&'static Mutex<History>> {
+    static TRACKER: OnceLock<Option<Mutex<History>>> = OnceLock::new();
+    TRACKER
+        .get_or_init(|| {
+            std::env::var_os("VICTORY_PLACED_FILLER_STATS")
+                .is_some_and(|value| value == "1")
+                .then(|| Mutex::new(History::default()))
+        })
+        .as_ref()
+}
+
+pub(crate) fn record(address: u64, normalized: &[u32; 14], raw: &[u32; 14]) {
+    if let Some(tracker) = tracker() {
+        tracker.lock().unwrap_or_else(|e| e.into_inner()).record(address, normalized, raw);
+    }
+}
+
+pub(crate) fn snapshot() -> Option<(usize, usize)> {
+    let history = tracker()?.lock().unwrap_or_else(|e| e.into_inner());
+    Some((history.keys.len(), history.twins))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_new_filler_variants_of_the_same_texture_count() {
+        let mut history = History::default();
+        let mut raw = [0; 14];
+        let mut normalized = raw;
+        history.record(0, &normalized, &raw);
+        raw[1] = 1;
+        history.record(0, &normalized, &raw);
+        history.record(0, &normalized, &raw);
+        history.record(1, &normalized, &raw);
+        raw[13] = 1;
+        history.record(0, &normalized, &raw);
+        normalized[3] = 512;
+        raw[3] = 512;
+        history.record(0, &normalized, &raw);
+        // The compatibility switch that keeps filler produces identical keys.
+        history.record(0, &raw, &raw);
+        assert_eq!((history.keys.len(), history.twins), (4, 1));
+    }
+
+    #[test]
+    fn the_sample_freezes_at_its_declared_limit() {
+        let mut history = History::default();
+        let normalized = [0; 14];
+        let mut raw = normalized;
+        for value in 1..=(MAX_KEYS + 8) {
+            raw[1] = value as u32;
+            history.record(0, &normalized, &raw);
+        }
+        assert_eq!((history.keys.len(), history.twins), (MAX_KEYS, MAX_KEYS - 1));
+    }
+}
