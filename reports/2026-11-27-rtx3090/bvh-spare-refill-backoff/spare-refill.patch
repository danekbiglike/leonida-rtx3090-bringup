+    // VIctory-NVIDIA #88 observed thousands of failed searches per frame.
+    // Local adaptation: danekbiglike/rtx3090-20261128-spare-refill.
+    // Only the spare-page refill backs off. A request for a page in use can
+    // still retry immediately if another thread has freed address space.
+    fn refill_with(&mut self, make_copy: impl FnOnce(u64, u64) -> Option<Arc<Shadow>>) -> bool {
+        if self.spare_failed_frame == Some(self.frame) {
+            return false;
+        }
+        let added = self.another_with(make_copy);
+        if !added {
+            if self.spare_failed_frame.is_none() {
+                tracing::warn!(frame = self.frame, "first failed spare arena refill; retries resume next frame");
+            }
+            self.spare_failed_frame = Some(self.frame);
+        }
+        added
     }
 
