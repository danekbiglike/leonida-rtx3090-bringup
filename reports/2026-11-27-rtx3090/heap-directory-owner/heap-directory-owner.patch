+    fn bind_views(&self, heap: &HostHeap) -> Option<u32> {
+        let mut run = heap.memory_views.lock().unwrap_or_else(|e| e.into_inner());
+        let (base, made) = match *run {
+            Some(bound) => bound,
+            None => {
+                // Held for the heap's life: not given back with a list's slots.
+                let base = heap.dynamic(COPIES + 1)?;
+                // Every slot of the run: a number shows no view of another kind.
+                for n in 0..=COPIES {
+                    heap.null_raw_uav_at(base + n);
