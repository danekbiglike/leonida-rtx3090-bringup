diff --git a/crates/victory-hle/src/modules/xmem/ssd_pool.rs b/crates/victory-hle/src/modules/xmem/ssd_pool.rs
new file mode 100644
--- /dev/null
+++ b/crates/victory-hle/src/modules/xmem/ssd_pool.rs
@@ -0,0 +1,89 @@
+//! Optional disk backing for the large physical page pool on low-RAM PCs.
+use std::fs::{File, OpenOptions};
+use std::io;
+use std::os::windows::fs::OpenOptionsExt;
+use std::os::windows::io::AsRawHandle;
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use windows_sys::Win32::Foundation::HANDLE;
+use windows_sys::Win32::Storage::FileSystem::FILE_FLAG_DELETE_ON_CLOSE;
+use windows_sys::Win32::System::Memory::{CreateFileMappingW, PAGE_READWRITE};
+
+static BUSY: AtomicBool = AtomicBool::new(false);
+static NEXT: AtomicU64 = AtomicU64::new(0);
+
+struct Slot;
+impl Drop for Slot {
+    fn drop(&mut self) {
+        BUSY.store(false, Ordering::Release);
+    }
+}
+
+pub(super) struct Backing {
+    _file: File,
+    _slot: Slot,
+}
+
+impl Backing {
+    pub(super) fn for_pool(bytes: usize) -> Option<(HANDLE, Self)> {
+        if !((1usize << 30)..=(8usize << 30)).contains(&bytes) {
+            return None;
+        }
+        let dir = std::env::var_os("VICTORY_PAGE_POOL_DIR")?;
+        match Self::create(Path::new(&dir), bytes) {
+            Ok(Some(section)) => {
+                tracing::warn!(
+                    bytes,
+                    "physical page pool uses a temporary file on the configured drive"
+                );
+                Some(section)
+            }
+            Ok(None) => None,
+            Err(error) => {
+                tracing::warn!(bytes, %error, "temporary page pool unavailable; using the standard physical section");
+                None
+            }
+        }
+    }
+
+    pub(super) fn create(dir: &Path, bytes: usize) -> io::Result<Option<(HANDLE, Self)>> {
+        if BUSY
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return Ok(None);
+        }
+        let slot = Slot;
+        let serial = NEXT.fetch_add(1, Ordering::Relaxed);
+        let path = dir.join(format!("victory-pool-{}-{serial}.tmp", std::process::id()));
+        let file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .custom_flags(FILE_FLAG_DELETE_ON_CLOSE)
+            .open(path)?;
+        file.set_len(bytes as u64)?;
+        // SAFETY: the newly created file is sized and read-write. A zero
+        // maximum size uses the file length, and every view shares its bytes.
+        let handle = unsafe {
+            CreateFileMappingW(
+                file.as_raw_handle(),
+                std::ptr::null(),
+                PAGE_READWRITE,
+                0,
+                0,
+                std::ptr::null(),
+            )
+        };
+        if handle.is_null() {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Some((
+            handle,
+            Self {
+                _file: file,
+                _slot: slot,
+            },
+        )))
+    }
+}
