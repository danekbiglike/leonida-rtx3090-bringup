 fn merge_piece(now: &[u8], held: &mut [u8], title: &mut [u8]) -> bool {
+    let len = now.len().min(held.len()).min(title.len());
+    #[cfg(target_arch = "x86_64")]
+    if len >= 64 && merge_piece_avx2_enabled() {
+        // SAFETY: AVX2 is present and all three slices cover len bytes.
+        return unsafe { merge_avx2(&now[..len], &mut held[..len], &mut title[..len]) };
+    }
+    merge_piece_scalar(now, held, title)
+}
