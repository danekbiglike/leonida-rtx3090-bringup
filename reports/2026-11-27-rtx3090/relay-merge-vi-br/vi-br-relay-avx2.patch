+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx2")]
+unsafe fn merge_avx2(now: &[u8], held: &mut [u8], title: &mut [u8]) -> bool {
+    use std::arch::x86_64::*;
+    let end = now.len() & !31;
+    let mut changes = _mm256_setzero_si256();
+    for i in (0..end).step_by(32) {
+        // SAFETY: i + 32 is inside each slice; the load and store accept unaligned addresses.
+        unsafe {
+            let n = _mm256_loadu_si256(now.as_ptr().add(i).cast());
+            let h = _mm256_loadu_si256(held.as_ptr().add(i).cast());
+            let equal = _mm256_cmpeq_epi8(n, h);
+            if _mm256_movemask_epi8(equal) == -1 {
+                continue;
+            }
+            let t = _mm256_loadu_si256(title.as_ptr().add(i).cast());
+            let value = _mm256_blendv_epi8(n, t, equal);
+            changes = _mm256_or_si256(changes, _mm256_xor_si256(value, t));
+            _mm256_storeu_si256(title.as_mut_ptr().add(i).cast(), value);
+            _mm256_storeu_si256(held.as_mut_ptr().add(i).cast(), n);
+        }
+    }
+    let remaining_changed = merge_piece_scalar(&now[end..], &mut held[end..], &mut title[end..]);
+    remaining_changed || _mm256_testz_si256(changes, changes) == 0
+}
