+/// Low-address memory owned locally until a title-memory directory or arena
+/// publishes it. A published address remains valid for the process lifetime.
+pub(crate) struct Reservation(usize);
+
+impl Reservation {
+    pub(crate) fn new(bytes: usize) -> Option<Self> {
+        reserve(bytes).map(Self)
+    }
+
+    pub(crate) fn address(&self) -> usize {
+        self.0
+    }
+
+    pub(crate) fn publish(self) -> usize {
+        let at = self.0;
+        std::mem::forget(self);
+        at
+    }
+}
+
+impl Drop for Reservation {
+    fn drop(&mut self) {
+        use windows_sys::Win32::System::Memory::{MEM_RELEASE, VirtualFree};
+        // SAFETY: the guard exclusively owns the whole VirtualAlloc2 allocation.
+        let freed = unsafe { VirtualFree(self.0 as *mut _, 0, MEM_RELEASE) };
+        debug_assert_ne!(freed, 0);
+    }
+}
