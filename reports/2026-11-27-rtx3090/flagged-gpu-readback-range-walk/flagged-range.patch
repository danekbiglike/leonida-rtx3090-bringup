+/// Relative offsets flagged anywhere in this plan for this copy and range.
+/// The input is the sorted, deduplicated output of `flagged_pieces`.
+/// Provenance: danekbiglike/rtx3090-20261127-flagged-range.
+fn flagged_in_range(pieces: &[(usize, u32)], copy: usize, first: u32, count: u32) -> impl Iterator<Item = u32> + '_ {
+    let begin = pieces.partition_point(|&piece| piece < (copy, first));
+    pieces[begin..].iter().map_while(move |&(owner, piece)| {
+        if owner != copy {
+            return None;
+        }
+        let offset = piece - first;
+        (offset < count).then_some(offset)
+    })
+}
