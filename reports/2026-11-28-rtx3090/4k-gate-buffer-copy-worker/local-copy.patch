+    #[test]
+    #[ignore = "requires a D3D12 device"]
+    fn striped_refresh_preserves_changed_bytes_and_holes() {
+        const MIB: usize = 1 << 20;
+        let mut title = vec![0u8; 10 * MIB];
+        for (i, byte) in title.iter_mut().enumerate() {
+            *byte = (i.wrapping_mul(13) ^ (i >> 9)) as u8;
+        }
+        let base = title.as_ptr() as usize;
+        let shadow = copy_of(base, title.len()).expect("mapped D3D12 staging buffer");
+        shadow.keep_stores();
+        let mut expected = vec![0; title.len()];
+        // Unaligned first and last stripes, disjoint writes, and both sides
+        // of the threshold where large transfers use the worker pool again.
+        for runs in [
+            vec![(17, MIB + 63, false), (2 * MIB + 25, 3 * MIB + 51, false)],
+            vec![(31, MIB + 9, true), (2 * MIB + 37, 3 * MIB + 23, true)],
+            vec![(5, 9 * MIB + 29, false)],
+        ] {
+            for &(a, b, known) in &runs {
+                if known {
+                    for i in (a..b).step_by(111) { title[i] ^= 0x75; }
+                }
+                expected[a..b].copy_from_slice(&title[a..b]);
+            }
+            let size: usize = runs.iter().map(|(a, b, _)| b - a).sum();
+            let absolute = runs.iter().map(|&(a, b, known)| (base + a, base + b, known)).collect();
+            assert_eq!(shadow.take_all(absolute), size);
+            // SAFETY: the per-shadow staging resource remains mapped and
+            // take_all has joined all its writers before returning.
+            let mapped = unsafe { std::slice::from_raw_parts(shadow.data, title.len()) };
+            assert!(mapped == expected.as_slice(), "refresh changed a hole or lost written bytes");
+        }
+        eprintln!("Verified all 10 MiB after each of three striped refreshes");
+    }
