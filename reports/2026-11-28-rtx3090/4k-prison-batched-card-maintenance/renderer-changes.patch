+// Runtime measurement of intermittent long worker waits. Keep the data local to
+// the call so several overlapping workers do not overwrite each other's timers.
+struct ReadTimer {
+    start: std::time::Instant,
+    len: usize,
+    stage: &'static str,
+}
+
+impl ReadTimer {
+    fn start(len: usize, stage: &'static str) -> Option<Self> {
+        static ON: OnceLock<bool> = OnceLock::new();
+        if len < 16 << 10 || !*ON.get_or_init(|| crate::switch::on("VICTORY_MEASURE_BUFFER_READS")) {
+            return None;
+        }
+        Some(Self { start: std::time::Instant::now(), len, stage })
+    }
+}
+
+impl Drop for ReadTimer {
+    fn drop(&mut self) {
+        let elapsed = self.start.elapsed();
+        if elapsed.as_millis() >= 100 {
+            tracing::info!(target: "victory_gpu::host::slow_refresh", windows_thread = thread_id(),
+                elapsed_us = elapsed.as_micros() as u64, span_bytes = self.len, stage = self.stage,
+                "slow title buffer read stage");
+        }
+    }
+}
