+/// Nearby source bytes can be read in one command when the gaps also fit.
+/// Retain the individual reads if those extra bytes would exhaust staging.
+fn staging_layout(places: &mut [Place], mut gap: usize, capacity: u64) -> Option<(Vec<Span>, u64)> {
+    loop {
+        let spans = lay_out(places, gap);
+        // Spans are appended in staging order and only the last can grow.
+        let end = spans.last().map_or(0, |s| s.at + s.len as u64);
+        if end <= capacity {
+            return Some((spans, end));
+        }
+        if gap == 0 {
+            return None;
+        }
+        gap = 0;
+    }
+}
