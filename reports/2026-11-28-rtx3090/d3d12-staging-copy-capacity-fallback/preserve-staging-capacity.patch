+    #[test]
+    #[ignore = "requires a D3D12 device"]
+    fn joined_and_compact_spans_preserve_d3d12_bytes() {
+        let host = host().expect("hardware D3D12 device");
+        for (count, stride, gap, expected_reads) in [
+            (40usize, 512usize, 0usize, 40usize),
+            (40, 512, 4096, 1),
+            (1200, 4096, 4096, 1200),
+        ] {
+            let len = 256usize;
+            let source_size = stride * count;
+            let output_size = (len + 16) * count + 32;
+            let (source, input) = host.shared_buffer(source_size as u64).unwrap();
+            let (destination, output) = host.shared_buffer(output_size as u64).unwrap();
+            let byte = |i: usize| (i ^ (i >> 7) ^ (i >> 15)) as u8;
+            // SAFETY: both mappings cover their requested size; the queue is idle.
+            unsafe {
+                for (i, b) in std::slice::from_raw_parts_mut(input, source_size).iter_mut().enumerate() {
+                    *b = byte(i);
+                }
+                std::ptr::write_bytes(output, 0xee, output_size);
+            }
+            let mut places: Vec<_> = (0..count).rev()
+                .map(|i| place(1, i * stride, len, 0, true))
+                .collect();
+            let (spans, _) = staging_layout(&mut places, gap, BETWEEN).unwrap();
+            assert_eq!(spans.len(), expected_reads);
+            let reads: Vec<_> = spans.iter().map(|s| (&source, s.src as u64, s.at, s.len as u64)).collect();
+            let mut expected = vec![0xee; output_size];
+            let writes: Vec<_> = places.iter().enumerate().map(|(index, p)| {
+                let offset = 16 + index * (len + 16);
+                for (i, out) in expected[offset..offset + len].iter_mut().enumerate() {
+                    *out = byte(p.src + i);
+                }
+                (&destination, offset as u64, p.at, p.len as u64)
+            }).collect();
+            let own = host.own_list().unwrap();
+            record(true, &own.list.list, &own.between, &reads, &writes);
+            own.list.close();
+            host.execute(&[&own.list]);
+            // SAFETY: execute waited for the list; the mapping is still live.
+            let actual = unsafe { std::slice::from_raw_parts(output, output_size) };
+            assert!(actual == expected.as_slice(), "incorrect GPU destination for {count} reads with gap {gap}");
+            assert_eq!(host.log_messages(), None);
+            eprintln!("Verified {count} logical reads via {expected_reads} staging copies including destination gaps");
+        }
