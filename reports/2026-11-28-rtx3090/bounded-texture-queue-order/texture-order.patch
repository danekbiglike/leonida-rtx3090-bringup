+/// The eligible write numbers captured while the texture queue is locked.
+#[derive(Default)]
+struct ReadyTextures {
+    again: Vec<(u32, u64)>,
+    fresh: Vec<(u32, u64)>,
+}
+
+impl ReadyTextures {
+    fn order(self, max: usize) -> Vec<(u32, u64)> {
+        let Self { mut again, mut fresh } = self;
+        if max == 0 {
+            return Vec::new();
+        }
+        let newest = |a: &(u32, u64), b: &(u32, u64)| b.1.cmp(&a.1);
+        if again.len() > max {
+            again.select_nth_unstable_by(max, newest);
+            again.truncate(max);
+        }
+        again.sort_unstable_by(newest);
+        let count = fresh.len().min(max - again.len());
+        if count == 0 {
+            return again;
+        }
+        let front = count.div_ceil(2);
+        let back = count / 2;
+        if front < fresh.len() {
+            fresh.select_nth_unstable_by(front, newest);
+        }
+        let (recent, rest) = fresh.split_at_mut(front);
+        recent.sort_unstable_by(newest);
+        let oldest = |a: &(u32, u64), b: &(u32, u64)| a.1.cmp(&b.1);
+        if back > 0 && back < rest.len() {
+            rest.select_nth_unstable_by(back, oldest);
+        }
+        let old = &mut rest[..back];
+        old.sort_unstable_by(oldest);
+        again.reserve(count);
+        for (i, &slot) in recent.iter().enumerate() {
+            again.push(slot);
+            if let Some(&other) = old.get(i) {
+                again.push(other);
+            }
+        }
+        again
     }
 }
 
