 const S_ENDPGM: u32 = 0xBF81_0000;
 
+#[test]
+fn group_load_must_follow_a_full_barrier_and_have_no_competing_writes() {
+    let store = [0xd8340000, 0x00000100]; // ds_write_b32 v0, v1
+    let load = [0xd8d80000, 0x02000000]; // ds_read_b32 v2, v0
+    let barrier = [0xbf8a0000];
+    for (words, all_lanes, expected) in [
+        ([&store[..], &barrier, &load].concat(), true, 1),
+        ([&store[..], &load].concat(), true, 0),
+        ([&store[..], &barrier, &load, &store].concat(), true, 0),
+        ([&store[..], &barrier, &load].concat(), false, 0),
+    ] {
+        let kernel = native(&words);
+        let p = ir::build(&kernel.code, kernel.wave64, kernel.vgprs).unwrap();
+        let st = structure::structure(&p).unwrap();
+        let all = vec![all_lanes; p.blocks.len()];
+        let reads = lower::read_only_group_loads(&p, &st, &all, &HashSet::new());
+        assert_eq!(reads.len(), expected);
+    }
+}
