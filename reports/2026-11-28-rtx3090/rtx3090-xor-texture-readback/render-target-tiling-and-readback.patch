+                    let mut seen = vec![false; (l.alignment / u64::from(n)) as usize];
+                    let first = l.offset(0, bx * bw, by * bh, 0).unwrap();
+                    let base = first - first % l.alignment;
+                    for y in by * bh..(by + 1) * bh {
+                        for x in bx * bw..(bx + 1) * bw {
