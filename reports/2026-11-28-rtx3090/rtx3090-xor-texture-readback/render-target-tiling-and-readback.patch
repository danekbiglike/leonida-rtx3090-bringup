+    #[test]
+    fn render_xor_layouts_match_the_address_library() {
+        for (series_s, n, hashes) in [
+            (false, 2, [0x1051_4417_061b_8725, 0x11a5_5308_ad39_a7b9]),
+            (false, 4, [0xd455_6429_b544_c925, 0x7a23_0211_6719_e58f]),
