+    #[test]
+    fn completed_pages_cover_only_whole_shadow_portions() {
+        use super::{PAGE, whole_shadow_pages};
+        let points = [0, 1, PAGE-1, PAGE, PAGE+1, 2*PAGE-1, 2*PAGE, 2*PAGE+1, 3*PAGE];
+        for &start in &points {
+            for &end in points.iter().filter(|&&v| v > start) {
+                for &from in points.iter().filter(|&&v| start <= v && v < end) {
+                    for &to in points.iter().filter(|&&v| from < v && v <= end) {
+                        let expected: Vec<_> = (from/PAGE..to.div_ceil(PAGE)).filter(|&page| {
+                            (page*PAGE).max(start) >= from && ((page+1)*PAGE).min(end) <= to
+                        }).collect();
+                        assert_eq!(whole_shadow_pages(from,to,start,end).collect::<Vec<_>>(),expected);
+                    }
+                }
+            }
+        }
+    }
