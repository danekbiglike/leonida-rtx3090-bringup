+    fn refresh_marks_whole_pages_only_after_the_bytes_arrive() {
+        use super::PAGE;
+        let mut title = vec![0u8; 4 * PAGE];
+        let base = (title.as_ptr() as usize).next_multiple_of(PAGE);
+        let aligned = base - title.as_ptr() as usize;
+        let data = &mut title[aligned..aligned + 3 * PAGE];
+        for (i, byte) in data.iter_mut().enumerate() {
+            *byte = (i ^ (i >> 8) ^ 0xa5) as u8;
+        }
+        let shadow = copy_of(base, data.len()).expect("RTX staging resource");
+        shadow.keep_stores();
+        let first = 15;
+        let end = data.len() - 19;
+        let transferred = shadow.copy_stale_with(base + first, base + end, 17, &[], |runs| {
+            assert!(shadow.copied.iter().all(|epoch| epoch.load(Ordering::Acquire) == 0));
+            let bytes = shadow.take_all(runs);
+            assert!(shadow.copied.iter().all(|epoch| epoch.load(Ordering::Acquire) == 0));
+            bytes
+        });
+        assert_eq!(transferred, end - first);
+        let stamps: Vec<_> = shadow.copied.iter().map(|epoch| epoch.load(Ordering::Acquire)).collect();
+        assert_eq!(stamps, [0, 17, 0]);
+        // SAFETY: mapped throughout this test and the synchronous transfer has returned.
+        let dest = unsafe { std::slice::from_raw_parts(shadow.data, data.len()) };
+        assert!(dest[..first].iter().chain(&dest[end..]).all(|&byte| byte == 0));
+        assert_eq!(dest[first..end], data[first..end]);
+        eprintln!("Verified deferred page publication and exact staging bytes across three pages");
+    }
 
