+// The copy recorder owns every D3D12 command-list call. Descriptor writers
+// use the device and disjoint slots. Both finish before the list is closed.
+pub(crate) fn prepare_card_groups(
+    active: &[bool; 8],
+    record: &(impl Fn() + Sync),
+    write_group: &(impl Fn(usize) + Sync),
+) {
+    if !active.iter().any(|&used| used) {
+        record();
+        return;
+    }
+    let run = |job| match job {
+        0 => record(),
+        i => write_group(i - 1),
+    };
+    let enabled = |job: usize| job == 0 || active[job - 1];
+    let batch = PARALLEL_BATCHES.fetch_add(1, Ordering::Relaxed);
+    if !batch.is_multiple_of(64) {
+        crate::land::each_under(9, &|job| {
+            if enabled(job) { run(job); }
+        });
+        return;
+    }
+    let times: [std::sync::OnceLock<(std::time::Instant, std::time::Instant)>; 9] = Default::default();
+    crate::land::each_under(9, &|job| {
+        if enabled(job) {
+            let start = std::time::Instant::now();
+            run(job);
+            let _ = times[job].set((start, std::time::Instant::now()));
+        }
+    });
+    let &(start, end) = times[0].get().expect("copy recorder ran");
+    // The longest single intersection is a lower bound even when several
+    // writers run at once. Wall times from different workers must not be added.
+    let overlap = times[1..].iter().filter_map(|t| t.get()).map(|&(a, b)| {
+        end.min(b).saturating_duration_since(start.max(a))
+    }).max().unwrap_or_default();
+    let mut sample = PARALLEL_SAMPLES.lock().unwrap_or_else(|err| err.into_inner());
+    sample.0 += 1;
+    sample.1 += u64::from(!overlap.is_zero());
+    sample.2 += overlap.as_micros() as u64;
+}
