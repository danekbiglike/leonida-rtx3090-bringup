 #[cfg(test)]
 mod tests {
+    #[test]
+    #[ignore = "requires an Enhanced Barriers D3D12 adapter"]
+    fn copy_pair_round_trip_on_hardware() {
+        let host = super::host().expect("D3D12 device");
+        assert!(super::enhanced_barriers(host));
+        let (first, first_ptr) = host.shared_buffer_now(1024).expect("first buffer");
+        let (second, second_ptr) = host.shared_buffer_now(1024).expect("second buffer");
+        let mut seed = 1771u32;
+        let mut bytes = |_| {
+            seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+            (seed >> 24) as u8
+        };
+        let mut expected_first: [u8; 1024] = std::array::from_fn(&mut bytes);
+        let mut expected_second: [u8; 1024] = std::array::from_fn(bytes);
+        // SAFETY: the two new mapped buffers are independently owned and at least 1024 bytes.
+        unsafe {
+            first_ptr.copy_from_nonoverlapping(expected_first.as_ptr(), 1024);
+            second_ptr.copy_from_nonoverlapping(expected_second.as_ptr(), 1024);
+        }
+        let list = host.new_list().expect("copy list");
+        let start = super::PAIRED_WAITS.load(super::Ordering::Relaxed);
+        for (index, (src, dst)) in [(&first, &second), (&second, &first)].into_iter().cycle().take(4).enumerate() {
+            let from = index * 128;
+            let to = from + 128;
+            super::wait_for_copy(host, &list.list, Some([src, dst]), super::CopyBoundary::Before);
+            // SAFETY: the resources are live and the 64-byte regions are in bounds.
+            unsafe { list.list.CopyBufferRegion(dst, to as u64, src, from as u64, 64) };
+            super::wait_for_copy(host, &list.list, Some([src, dst]), super::CopyBoundary::After);
+            if index % 2 == 0 {
+                expected_second[to..to + 64].copy_from_slice(&expected_first[from..from + 64]);
+            } else {
+                expected_first[to..to + 64].copy_from_slice(&expected_second[from..from + 64]);
+            }
+        }
+        list.close();
+        host.execute_sync_internal(&list);
+        assert_eq!(super::PAIRED_WAITS.load(super::Ordering::Relaxed) - start, 8);
+        // SAFETY: submission has completed; both mappings are live and CPU-readable.
+        unsafe {
+            host.device.GetDeviceRemovedReason().expect("copy completed on device");
+            assert_eq!(std::slice::from_raw_parts(first_ptr, 1024), &expected_first);
+            assert_eq!(std::slice::from_raw_parts(second_ptr, 1024), &expected_second);
+        }
+    }
