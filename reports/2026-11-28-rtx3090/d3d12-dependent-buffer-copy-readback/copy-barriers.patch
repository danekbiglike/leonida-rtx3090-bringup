+fn distinct_owned_buffers(same_resource: bool, src_placed: bool, dst_placed: bool) -> bool {
+    !same_resource && !src_placed && !dst_placed
+}
+
+/// Order access to both independently backed buffers on either side of the copy.
+/// A view of shared guest memory can alias a third resource and stays on the global path.
+#[derive(Clone, Copy)]
+enum CopyBoundary { Before, After }
+
+fn wait_for_copy(host: &Host, list: &ID3D12GraphicsCommandList, pair: Option<[&ID3D12Resource; 2]>, boundary: CopyBoundary) {
+    if let Some([source, destination]) = pair
+        && enhanced_barriers(host)
+        && let Ok(list7) = list.cast::<ID3D12GraphicsCommandList7>()
+    {
+        let make = |resource: &ID3D12Resource, access| {
+            let (from, to, old, new) = match boundary {
+                CopyBoundary::Before => (D3D12_BARRIER_SYNC_ALL, D3D12_BARRIER_SYNC_COPY, D3D12_BARRIER_ACCESS_COMMON, access),
+                CopyBoundary::After => (D3D12_BARRIER_SYNC_COPY, D3D12_BARRIER_SYNC_ALL, access, D3D12_BARRIER_ACCESS_COMMON),
+            };
+            D3D12_BUFFER_BARRIER {
+                SyncBefore: from,
+                SyncAfter: to,
+                AccessBefore: old,
+                AccessAfter: new,
+                pResource: std::mem::ManuallyDrop::new(Some(resource.clone())),
+                Offset: 0,
+                Size: u64::MAX,
+            }
+        };
+        let mut buffers = [make(source, D3D12_BARRIER_ACCESS_COPY_SOURCE), make(destination, D3D12_BARRIER_ACCESS_COPY_DEST)];
+        let group = D3D12_BARRIER_GROUP {
+            Type: D3D12_BARRIER_TYPE_BUFFER,
+            NumBarriers: buffers.len() as u32,
+            Anonymous: D3D12_BARRIER_GROUP_0 { pBufferBarriers: buffers.as_ptr() },
+        };
+        // SAFETY: both references and the group are live for this open-list call.
+        unsafe { list7.Barrier(&[group]) };
+        for buffer in &mut buffers {
+            // SAFETY: each field owns one clone and is dropped exactly once.
+            unsafe { std::mem::ManuallyDrop::drop(&mut buffer.pResource) };
+        }
+        PAIRED_WAITS.fetch_add(1, Ordering::Relaxed);
+        return;
+    }
+    // SAFETY: the caller is recording into the list.
+    unsafe { wait_for_all(host, list) };
+}
