+#[cfg(test)]
+mod raw_container_tests {
+    use super::sources;
+
+    #[test]
+    fn embedded_container_hashes_match_standalone_inputs() {
+        let mut a = [0u8; 32];
+        a[..4].copy_from_slice(b"DXBC");
+        a[0x18..0x1c].copy_from_slice(&32u32.to_le_bytes());
+        let mut b = a;
+        b[4] = 1;
+        let archive = [&a[..], b"padding", &b, b"trailer", b"DXBC"].concat();
+        let set = sources(&archive);
+        assert_eq!(set.len(), 2);
+        for (found, standalone) in set.iter().zip([&a, &b]) {
+            let bytes = found.bytes().unwrap();
+            assert_eq!(blake3::hash(&bytes), blake3::hash(standalone));
+            assert_eq!(bytes.len(), 32);
+        }
+    }
+}
