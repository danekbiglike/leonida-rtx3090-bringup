@@ -0,0 +1,104 @@
+/// The refresh interval for each shadow from the submission's existing shadow index.
+/// Writes block subsequent refreshes until the next part. The order of first use
+/// is preserved even for a shadow first seen in a write.
+#[derive(Default)]
+pub(super) struct FrontRanges {
+    slots: Vec<Slot>,
+    order: Vec<usize>,
+    part: usize,
+}
+
+#[derive(Clone, Copy)]
+struct Slot {
+    from: usize,
+    to: usize,
+    blocked: usize,
+    seen: bool,
+}
+
+impl FrontRanges {
+    pub(super) fn begin(&mut self, size: usize) {
+        self.slots.clear();
+        self.slots.resize(size, Slot { from: usize::MAX, to: 0, blocked: 0, seen: false });
+        self.order.clear();
+        self.part = 1;
+    }
+
+    pub(super) fn next_part(&mut self) {
+        self.part += 1;
+    }
+
+    fn touch(&mut self, index: usize) -> &mut Slot {
+        let slot = &mut self.slots[index];
+        if !slot.seen {
+            slot.seen = true;
+            self.order.push(index);
+        }
+        slot
+    }
+
+    pub(super) fn refresh(&mut self, index: usize, from: usize, to: usize) {
+        let part = self.part;
+        let slot = self.touch(index);
+        if slot.blocked != part {
+            slot.from = slot.from.min(from);
+            slot.to = slot.to.max(to);
+        }
+    }
+
+    pub(super) fn write(&mut self, index: usize) {
+        let part = self.part;
+        self.touch(index).blocked = part;
+    }
+
+    pub(super) fn ranges(&self) -> impl Iterator<Item = (usize, usize, usize)> + '_ {
+        self.order.iter().filter_map(|&index| {
+            let slot = &self.slots[index];
+            (slot.from < slot.to).then_some((index, slot.from, slot.to))
+        })
+    }
+}
+pub(super) enum FrontStep {
+    Refresh { index: usize, from: usize, to: usize },
+    Write { shadow_key: usize },
+    Part,
+}
+
+impl FrontRanges {
+    /// Refreshes already have an index from the submission walk. A write can
+    /// precede its shadow's first refresh, so resolve writes after that walk.
+    pub(super) fn replay(&mut self, size: usize, steps: impl Iterator<Item = FrontStep>, index_of: impl Fn(usize) -> Option<usize>) {
+        self.begin(size);
+        for step in steps {
+            match step {
+                FrontStep::Part => self.next_part(),
+                FrontStep::Refresh { index, from, to } => self.refresh(index, from, to),
+                FrontStep::Write { shadow_key } => {
+                    if let Some(index) = index_of(shadow_key) {
+                        self.write(index);
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod replay_tests {
+    use super::{FrontRanges, FrontStep::*};
+
+    #[test]
+    fn an_early_write_blocks_its_part_and_keeps_first_touch_order() {
+        let mut ranges = FrontRanges::default();
+        let steps = [
+            Write { shadow_key: 90 },
+            Write { shadow_key: 22 },
+            Refresh { index: 0, from: 8, to: 12 },
+            Refresh { index: 1, from: 0, to: 100 },
+            Part,
+            Refresh { index: 1, from: 20, to: 26 },
+        ];
+        ranges.replay(2, steps.into_iter(), |key| (key == 22).then_some(1));
+        assert_eq!(ranges.ranges().collect::<Vec<_>>(), [(1, 20, 26), (0, 8, 12)]);
+    }
+}
