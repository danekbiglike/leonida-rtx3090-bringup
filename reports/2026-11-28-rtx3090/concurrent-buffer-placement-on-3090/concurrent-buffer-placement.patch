+    #[test]
+    fn small_buffer_placement_proceeds_during_heap_creation() {
+        use std::sync::mpsc::channel;
+        use std::time::Duration;
+
+        static POOL: Mutex<Pool<u64>> = Mutex::new(Pool::new(SPARE));
+        let align = 64 << 10;
+        for i in 0..BLOCK / BUFFER_MOST {
+            let len = if i + 1 == BLOCK / BUFFER_MOST { BUFFER_MOST - align } else { BUFFER_MOST };
+            let (piece, heap, _) = take_from(&POOL, len, align, || Ripe::ALL, || Some(1)).unwrap();
+            assert_eq!((piece.start, heap), (i * BUFFER_MOST, 1));
+        }
+
+        let (entered, creating) = channel();
+        let (release, pending) = channel();
+        let timeout = Duration::from_secs(10);
+        std::thread::scope(|scope| {
+            let large = scope.spawn(move || {
+                take_from(&POOL, BUFFER_MOST, align, || Ripe::ALL, || {
+                    entered.send(()).unwrap();
+                    pending.recv_timeout(timeout).expect("small placement was blocked by heap creation");
+                    Some(2)
+                }).expect("buffer in the new block")
+            });
+            creating.recv_timeout(timeout).expect("first heap is full for the large request");
+            let (second, heap, _) = take_from(&POOL, align, align, || Ripe::ALL, || {
+                panic!("space remains in the first heap")
+            }).unwrap();
+            assert_eq!((second.start, heap), (BLOCK - align, 1));
+            release.send(()).unwrap();
+            let (piece, heap, _) = large.join().unwrap();
+            assert_eq!((piece.start, piece.len, heap), (0, BUFFER_MOST, 2));
+        });
     }
 
