+    #[test]
+    #[ignore = "checks the configured ambient grid on a graphics device"]
+    fn grid_storage_matches_every_dispatched_point() {
+        let host = host().expect("RTX 3090 test device");
+        let pass = make(&host.device, |bytes| host.uav_buffer(bytes)).expect("lighting pipelines");
+        let (px, py): (u32, u32) = match std::env::var("VICTORY_AMBIENT_GRID").as_deref() {
+            Ok("192x108") => (192, 108),
+            Ok("160x90") => (160, 90),
+            _ => panic!("set the expected grid"),
+        };
+        assert_eq!(pass.gather_groups, [px / 16, py / 2]);
+        // SAFETY: the pass owns this resource.
+        assert_eq!(unsafe { pass.points.GetDesc() }.Width, u64::from(px) * u64::from(py) * 64);
+        println!("Verified grid {px}x{py} with full point storage and exact dispatch coverage.");
