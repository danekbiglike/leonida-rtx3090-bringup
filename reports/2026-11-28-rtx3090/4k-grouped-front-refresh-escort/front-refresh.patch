+fn front_group_width(buffers: usize) -> usize {
+    static WIDTH: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    if buffers <= 256 { return 1; }
+    *WIDTH.get_or_init(|| std::env::var("VICTORY_FRONT_REFRESH_GROUP").ok()
+        .and_then(|s| s.parse::<usize>().ok()).filter(|n| matches!(n, 1 | 2 | 4 | 8)).unwrap_or(1))
+}
