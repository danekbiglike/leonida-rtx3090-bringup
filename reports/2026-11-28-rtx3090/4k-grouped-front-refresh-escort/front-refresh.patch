+/// Texture refreshes claim one job each. Buffer workers share adjacent spans;
+/// a short last group and an empty buffer list need no special tasks.
+fn visit_front_jobs(textures: usize, buffers: usize, width: usize,
+    texture: impl Fn(usize) + Send + Sync + 'static,
+    buffer_group: impl Fn(std::ops::Range<usize>) + Send + Sync + 'static) {
+    crate::shadow::wide_each(textures + buffers.div_ceil(width), move |job| {
+        if job < textures {
+            texture(job);
+        } else {
+            let first = (job - textures) * width;
+            buffer_group(first..(first + width).min(buffers));
+        }
+    });
+}
