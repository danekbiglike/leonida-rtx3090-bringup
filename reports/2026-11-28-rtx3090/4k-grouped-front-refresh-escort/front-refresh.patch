+#[cfg(test)]
+mod front_jobs_tests {
+    use super::visit_front_jobs;
+    use std::sync::{Arc, atomic::{AtomicU8, Ordering}};
+
+    #[test]
+    fn front_refresh_visits_each_texture_and_buffer_once() {
+        for (textures, buffers) in [(0,0), (0,7), (3,0), (1,1), (12,257), (3,4099)] {
+            for width in [1,2,4,8] {
+                let counts = Arc::new((0..textures+buffers).map(|_| AtomicU8::new(0)).collect::<Vec<_>>());
+                let tex = counts.clone();
+                let buf = counts.clone();
+                visit_front_jobs(textures, buffers, width,
+                    move |i| { assert!(i < textures); tex[i].fetch_add(1, Ordering::Relaxed); },
+                    move |range| {
+                        assert!(range.len() <= width && !range.is_empty());
+                        for i in range { buf[textures+i].fetch_add(1, Ordering::Relaxed); }
+                    });
+                assert!(counts.iter().all(|n| n.load(Ordering::Relaxed) == 1));
+            }
+        }
+    }
+}
