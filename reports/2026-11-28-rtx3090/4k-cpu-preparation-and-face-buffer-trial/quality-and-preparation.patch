+    let title = Title::new();
+    let addr = title.0;
+    register(1, addr, K64 as u64);
+    assert!(lookup_with(addr, 1, false, |_| None).is_none());
+    assert!(lookup_with(addr, 1, false, allocate).is_some());
+}
