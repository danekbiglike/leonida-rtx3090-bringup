+#[cfg(feature = "diagnostics")]
+fn checked_remap_slots(placed: &Spans, ranges: &mut [(u64, u64)], sample: u64) -> Vec<u32> {
+    fn timed(f: impl FnOnce() -> Vec<u32>) -> (Vec<u32>, u128) {
+        let start = std::time::Instant::now();
+        let slots = f();
+        (slots, start.elapsed().as_nanos())
+    }
+    let original = ranges.to_vec();
+    let old = || placed.remap_slots_individually(&original);
+    let new = || placed.remap_slots(ranges);
+    let ((mut reference, old_ns), (mut slots, new_ns)) = if sample % 2 == 0 {
+        (timed(old), timed(new))
+    } else {
+        let result = timed(new);
+        (timed(old), result)
+    };
+    reference.sort_unstable();
+    reference.dedup();
+    slots.sort_unstable();
+    slots.dedup();
+    let matched = reference == slots;
+    tracing::info!(target: "victory_gpu::host", sample, ranges = original.len(), slots = slots.len(),
+        old_ns = old_ns as u64, new_ns = new_ns as u64, matched, "texture remap comparison");
+    if matched { slots } else { reference }
