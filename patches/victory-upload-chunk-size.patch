 /// leaves them alone, and `Shadow::copy_stale` is given whole pages).
 const COPY_CHANGED_CHUNK: usize = 256;
 
+/// Coarser blocks trade some upload bandwidth for fewer dirty ranges and
+/// comparisons. Only a refresh outside pending shader writes uses this size.
+fn upload_chunk(bytes: Option<&str>) -> usize {
+    bytes.and_then(|value| value.parse::<usize>().ok())
+        .filter(|n| n.is_power_of_two() && (256..=16384).contains(n))
+        .unwrap_or(COPY_CHANGED_CHUNK)
+}
+
+fn upload_chunk_size() -> usize {
+    static BYTES: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *BYTES.get_or_init(|| upload_chunk(std::env::var("VICTORY_UPLOAD_CHUNK_BYTES").ok().as_deref()))
+}
