+// The title can fill a shader-visible heap with ordinary CPU stores into its own backing.
+// The queue requests only the declared table span before submission. Match by the real heap
+// address and hold the registration lock so a concurrent Release cannot free either allocation.
+std::uint64_t pull_title_descriptors(void*, std::uint8_t* real, std::size_t bytes) {
+    if (!real || !bytes || !g_custom_range_count.load(std::memory_order_acquire)) return 0;
+    const auto address = reinterpret_cast<SIZE_T>(real);
+    std::lock_guard lock(descriptor_range_mutex());
+    const auto& ranges = descriptor_ranges();
+    for (auto it = ranges.rbegin(); it != ranges.rend(); ++it) {
+        if (!it->mirror || address < it->real_start) continue;
+        const SIZE_T offset = address - it->real_start;
+        const SIZE_T size = it->custom_end - it->custom_start;
+        if (offset >= size || offset % it->stride) continue;
+        const SIZE_T count = std::min<SIZE_T>(bytes, size - offset) / it->stride;
+        if (!count) return 0;
+        const SIZE_T span = count * it->stride, source = it->custom_start + offset;
+        if (!descriptor_memory_accessible(source, span, false) || !descriptor_memory_accessible(address, span, true))
+            return 0;
+        std::memmove(real, reinterpret_cast<const void*>(source), span);
+        return count;
+    }
+    return 0;
+}
