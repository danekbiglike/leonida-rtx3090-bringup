+const TEXTURE_BLOCK: usize = 64 << 10;
+static BATCH_RESIDENCY: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+pub(super) fn streaming_optimizations() -> bool {
+    BATCH_RESIDENCY.load(std::sync::atomic::Ordering::Relaxed)
+}
+static MEASURE_RESIDENCY: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static RESIDENCY_TOTALS: [std::sync::atomic::AtomicU64; 3] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+
+// Optional in-game A/B. Each caption interval is entirely in one mode, except
+// work already in flight at the boundary. Leave the fast path enabled normally.
+pub(crate) fn residency_interval(frames: u64, ms: f64, draws: f64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    static STOP_FILE: std::sync::OnceLock<Option<std::path::PathBuf>> = std::sync::OnceLock::new();
+    let Some(stop_file) = STOP_FILE.get_or_init(|| {
+        std::env::var_os("VICTORY_RESIDENCY_AB")?;
+        Some(std::path::PathBuf::from(std::env::var_os("LOCALAPPDATA")?).join("residency-complete"))
+    }) else { return; };
+    if stop_file.exists() {
+        MEASURE_RESIDENCY.store(false, Relaxed);
+        BATCH_RESIDENCY.store(true, Relaxed);
+        return;
+    }
+    static INTERVAL: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    let interval = INTERVAL.fetch_add(1, Relaxed);
+    let batch = BATCH_RESIDENCY.load(Relaxed);
+    let [calls, blocks, probe_us] = [0, 1, 2].map(|i| RESIDENCY_TOTALS[i].swap(0, Relaxed));
+    tracing::warn!(interval, batch, frames, ms, draws, calls, blocks, probe_us, "texture residency comparison");
+    MEASURE_RESIDENCY.store(true, Relaxed);
+    // ABBA in four-interval groups to balance steady changes in scene load.
+    BATCH_RESIDENCY.store(matches!(((interval + 1) / 4) % 4, 0 | 3), Relaxed);
+}
+
+fn sampled_block_bytes(start: usize, end: usize, batch: bool) -> u64 {
+    use windows_sys::Win32::System::ProcessStatus::{K32QueryWorkingSetEx, PSAPI_WORKING_SET_EX_INFORMATION};
+    use windows_sys::Win32::System::Threading::GetCurrentProcess;
+    const PAGE: usize = 4096;
+    let mut block = start & !(TEXTURE_BLOCK - 1);
+    let mut there = 0u64;
+    if !batch || end - block <= TEXTURE_BLOCK {
+        while block < end {
+            let next = block.saturating_add(TEXTURE_BLOCK);
+            let lo = block.max(start);
+            if readable(lo, 1, true).0 == 1 {
+                there += (next.min(end) - lo) as u64;
+            }
+            block = next;
+        }
+        return there;
+    }
+    // Query the same 4 KiB page in each console block as the scalar path.
+    // A trimmed page still needs the one-byte kernel read to distinguish
+    // a readable allocation from a missing page.
+    // SAFETY: the Windows query records contain only a pointer and flags.
+    let mut info: [PSAPI_WORKING_SET_EX_INFORMATION; 128] = unsafe { std::mem::zeroed() };
+    while block < end {
+        let count = (end - block).div_ceil(TEXTURE_BLOCK).min(info.len());
+        let entries = &mut info[..count];
+        for (i, entry) in entries.iter_mut().enumerate() {
+            let lo = (block + i * TEXTURE_BLOCK).max(start);
+            entry.VirtualAddress = (lo & !(PAGE - 1)) as *mut _;
+        }
+        // SAFETY: the kernel fills this mutable slice for the current process.
+        let asked = unsafe {
+            K32QueryWorkingSetEx(GetCurrentProcess(), entries.as_mut_ptr().cast(), size_of_val(entries) as u32)
+        } != 0;
+        for entry in entries {
+            // SAFETY: on success the flags were filled in by the query.
+            let valid = asked && unsafe { entry.VirtualAttributes.Flags } & 1 != 0;
+            let next = block.saturating_add(TEXTURE_BLOCK);
+            if valid || crate::host::read_into(entry.VirtualAddress.cast(), &mut [0u8]) {
+                there += (next.min(end) - block.max(start)) as u64;
+            }
+            block = next;
+        }
+    }
+    there
+}
