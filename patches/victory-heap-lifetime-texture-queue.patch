 /// [`HostHeap::buffers`].
 const SLOT_IN_BUFFERS: u8 = 1 << 2;

+/// The directly indexed buffers retained by one descriptor heap between passes.
+pub(crate) struct BufferRangeCache<T> {
+    passes: u64,
+    pub(crate) by_slot: std::collections::HashMap<u32, (T, u64, u64)>,
+}
+
+impl<T> BufferRangeCache<T> {
+    fn new() -> Self {
+        Self { passes: 0, by_slot: Default::default() }
+    }
+
+    pub(crate) fn next_slots(&mut self, changed: Vec<u32>, all: impl FnOnce() -> Vec<u32>) -> Vec<u32> {
+        let slots = if self.passes.is_multiple_of(16) {
+            self.by_slot.clear();
+            all()
+        } else {
+            changed
+        };
+        self.passes = self.passes.wrapping_add(1);
+        slots
+    }
+}
+
+#[cfg(feature = "diagnostics")]
+impl<T> Drop for BufferRangeCache<T> {
+    fn drop(&mut self) {
+        if !self.by_slot.is_empty() {
+            tracing::info!(target: "victory_gpu::host", slots = self.by_slot.len(),
+                "descriptor heap releasing retained buffer views");
+        }
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn buffer_ranges_follow_the_heap_lifetime() {
+    use std::sync::Arc;
+    let mut cache = Box::new(BufferRangeCache::new());
+    let owner = Arc::new(());
+    let reference = Arc::downgrade(&owner);
+    assert_eq!(cache.next_slots(vec![], || vec![3, 9]), vec![3, 9]);
+    cache.by_slot.insert(3, (owner, 0, 4096));
+    for _ in 1..16 {
+        assert_eq!(cache.next_slots(vec![9], || unreachable!()), vec![9]);
+    }
+    assert_eq!(cache.next_slots(vec![], || vec![3, 9]), vec![3, 9]);
+    assert!(reference.upgrade().is_none());
+    let owner = Arc::new(());
+    let reference = Arc::downgrade(&owner);
+    cache.by_slot.insert(9, (owner, 0, 4096));
+    *cache = BufferRangeCache::new();
+    assert!(reference.upgrade().is_none());
+    assert_eq!(cache.next_slots(vec![], || vec![27]), vec![27]);
+}
