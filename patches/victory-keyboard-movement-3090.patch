+
+/// Combine keyboard controls with an attached pad, keeping untouched axes.
+fn merge_keyboard_pad(pad: &mut PadState, keyboard: &PadState) {
+    pad.buttons |= keyboard.buttons;
+    pad.left_trigger = pad.left_trigger.max(keyboard.left_trigger);
+    pad.right_trigger = pad.right_trigger.max(keyboard.right_trigger);
+    if keyboard.left_x != 0.0 {
+        pad.left_x = keyboard.left_x;
+    }
+    if keyboard.left_y != 0.0 {
+        pad.left_y = keyboard.left_y;
+    }
+    if keyboard.right_x != 0.0 {
+        pad.right_x = keyboard.right_x;
+    }
+    if keyboard.right_y != 0.0 {
+        pad.right_y = keyboard.right_y;
+    }
+}
+
+#[test]
+fn keyboard_axes_merge_with_attached_pad() {
+    let mut pad = PadState { buttons: B, left_x: 0.5, right_y: -0.5, ..Default::default() };
+    let keyboard = fallback(&[
+        KeyState { virtual_key: b'W', ..Default::default() },
+        KeyState { virtual_key: b'L', ..Default::default() },
+        KeyState { virtual_key: b'Z', ..Default::default() },
+    ]);
+    merge_keyboard_pad(&mut pad, &keyboard);
+    assert_eq!(pad.buttons, B);
+    assert_eq!(pad.left_x, 0.5);
+    assert_eq!(pad.left_y, 1.0);
+    assert_eq!(pad.right_x, 1.0);
+    assert_eq!(pad.right_y, -0.5);
+    assert_eq!(pad.left_trigger, 1.0);
 }
 
