diff --git a/runtime/shims/file_system.cpp b/runtime/shims/file_system.cpp
index a7b64d75..e7645c8d 100644
--- a/runtime/shims/file_system.cpp
+++ b/runtime/shims/file_system.cpp
@@ -666,7 +666,20 @@ HANDLE WINAPI create_file_w(LPCWSTR name, DWORD access, DWORD share, LPSECURITY_
         SetLastError(t.error);
         return INVALID_HANDLE_VALUE;
     }
-    const HANDLE h = ::CreateFileW(t.path.c_str(), access, share, attributes, disposition, flags, template_file);
+    HANDLE h = ::CreateFileW(t.path.c_str(), access, share, attributes, disposition, flags, template_file);
+    // A host application may hold a writable package handle that allows readers. DirectStorage asks
+    // for shared read access; retain that access and allow the pre-existing writer on the second open.
+    if (h == INVALID_HANDLE_VALUE && GetLastError() == ERROR_SHARING_VIOLATION &&
+        access == GENERIC_READ && share == FILE_SHARE_READ && disposition == OPEN_EXISTING &&
+        !(flags & FILE_FLAG_DELETE_ON_CLOSE)) {
+        const Roots r = roots();
+        if (!r.game.empty() && lies_under(t.path.wstring(), r.game)) {
+            h = ::CreateFileW(t.path.c_str(), access, share | FILE_SHARE_WRITE,
+                              attributes, disposition, flags, template_file);
+        } else {
+            SetLastError(ERROR_SHARING_VIOLATION);
+        }
+    }
     if (h == INVALID_HANDLE_VALUE) {
         const DWORD error = GetLastError();
         note_open_failure("CreateFileW", name, error, _ReturnAddress());
