     // step rate 0 also take stride 0, so every instance reads element 0.
@@ -2203,6 +2200,10 @@ ReplayResult prepare_draw(const Draw& draw, Resolve&& resolve, const ReplayFunct
                 return ReplayResult::unresolved_resource;
