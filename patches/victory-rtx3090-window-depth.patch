+/// New snapshot bytes in a write declaration. `target` is clipped to this
+/// buffer and expressed in offsets; pending declarations are absolute.
+fn uncovered_write_offsets(base: usize, target: (usize, usize), pending: &[(usize, usize)]) -> Vec<(usize, usize)> {
+    let (from, to) = target;
+    if from >= to {
+        return Vec::new();
+    }
+    let (begin, end) = (base + from, base + to);
+    let mut overlaps = Vec::new();
+    for &(a, b) in pending {
+        if a <= begin && b >= end {
+            return Vec::new();
+        }
+        let (left, right) = (a.max(begin), b.min(end));
+        if left < right {
+            overlaps.push((left - base, right - base));
+        }
+    }
+    outside(from, to, overlaps)
+}
+
+#[cfg(test)]
+mod write_offset_tests {
+    use super::uncovered_write_offsets;
+
+    #[test]
+    fn clipped_snapshot_gaps_match_a_byte_map() {
+        let base = 301usize;
+        let mut pending = vec![(base - 8, base + 2), (base + 67, base + 103)];
+        let mut state = 73u32;
+        for step in 0..90 {
+            let from = (step * 23) % 65;
+            let to = (from + step % 31).min(70);
+            let gaps = uncovered_write_offsets(base, (from, to), &pending);
+            assert!(gaps.windows(2).all(|w| w[0].1 < w[1].0));
+            for i in 0..70 {
+                let expected = (from..to).contains(&i)
+                    && !pending.iter().any(|&(a,b)| (a..b).contains(&(base+i)));
+                assert_eq!(gaps.iter().any(|&(a,b)| (a..b).contains(&i)), expected);
+            }
+            state = state.wrapping_mul(1664525).wrapping_add(1013904223);
+            let a = base - 8 + (state >> 16) as usize % 90;
+            pending.push((a, a + step % 10));
+            if step % 11 == 10 { pending.drain(..5); }
+        }
+    }
+}
