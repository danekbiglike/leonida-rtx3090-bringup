diff --git a/runtime/shims/d3d12_vulkan_device.cpp b/runtime/shims/d3d12_vulkan_device.cpp
index 81a36a49248df07efd7df2918fb548719664ac6c..9ae2294c6c444f92ae069189a5d0aa36b5d85f13 100644
--- a/runtime/shims/d3d12_vulkan_device.cpp
+++ b/runtime/shims/d3d12_vulkan_device.cpp
@@ -7376,7 +7376,10 @@ public:
         view.mip_count = 1;
         if (!desc) {
             const bool array = r->desc().DepthOrArraySize > 1;
-            if (r->desc().Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE1D && !array) {
+            if (r->desc().Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE3D) {
+                view.type = leonida::gfx10::ImageType::image_3d;
+                view.layer_count = 1;
+            } else if (r->desc().Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE1D && !array) {
                 view.type = leonida::gfx10::ImageType::image_1d;
                 view.layer_count = 1;
             } else if (array)
@@ -7394,6 +7397,21 @@ public:
                 view.layer_count = 1;
                 view.plane = desc->Texture2D.PlaneSlice;
                 break;
+            case D3D12_UAV_DIMENSION_TEXTURE3D: {
+                const auto& range = desc->Texture3D;
+                if (r->desc().Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE3D || range.MipSlice >= r->desc().MipLevels)
+                    return;
+                const UINT depth = std::max(1u, UINT(r->desc().DepthOrArraySize) >> range.MipSlice);
+                // A standard Vulkan 3D view covers every W slice at its selected mip.
+                if (range.FirstWSlice || (range.WSize != UINT_MAX && range.WSize != depth)) {
+                    log_once("partial or invalid volume UAV depth range; requested count", int(range.WSize));
+                    return;
+                }
+                view.type = leonida::gfx10::ImageType::image_3d;
+                view.first_mip = range.MipSlice;
+                view.layer_count = 1;
+                break;
+            }
             case D3D12_UAV_DIMENSION_TEXTURE2DARRAY:
                 view.type = leonida::gfx10::ImageType::image_2d_array;
                 view.first_mip = desc->Texture2DArray.MipSlice;
@@ -9159,6 +9177,13 @@ private:
         const bool registered = state_.bind_image(words, image, resource.image(), resource.format(),
                                                   resource.aspects(), storage, resource.has_view_format_list(),
                                                   resource.uint_backed());
+        if (storage && image.type == leonida::gfx10::ImageType::image_3d) {
+            static const bool observe = GetEnvironmentVariableW(L"LEONIDA_FRAME_GRAPH", nullptr, 0) != 0;
+            static std::atomic_uint64_t volumes{0};
+            if (observe && ++volumes <= 64)
+                std::fprintf(stderr, "[frame-graph] volume-uav size=%u,%u,%u mip=%u format=%u registered=%d\n",
+                             image.width, image.height, image.depth, image.first_mip, UINT(resource.desc().Format), registered);
+        }
         if (registered && resource.sparse_image()) state_.context->note_shader_image(resource.id());
         if (leonida::gfx10::multisampled(image.type) && !registered) return;
         std::memcpy(reinterpret_cast<void*>(destination.ptr), words.data(), sizeof(words));
