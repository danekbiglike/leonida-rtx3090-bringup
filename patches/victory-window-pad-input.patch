+/// Keep a short tap on a window's mapped controller keys visible to frame-based polling.
+#[derive(Default)]
+struct WindowTaps(Vec<(u8, Instant, bool)>);
+
+impl WindowTaps {
+    fn change(&mut self, key: u8, down: bool, at: Instant) {
+        if !FALLBACK_BUTTONS.iter().any(|&(vk, _)| vk == key) {
+            return;
+        }
+        if down {
+            self.0.retain(|&(vk, _, _)| vk != key);
+            self.0.push((key, at + Duration::from_millis(65), true));
+        } else if let Some(entry) = self.0.iter_mut().find(|entry| entry.0 == key) {
+            entry.2 = false;
+        }
+    }
+
+    fn add_active(&mut self, now: Instant, down: &mut Vec<u8>) {
+        self.0.retain(|&(_, until, held)| held || now < until);
+        for &(vk, _, _) in &self.0 {
+            if !down.contains(&vk) {
+                down.push(vk);
+            }
+        }
+    }
+}
+
+static WINDOW_TAPS: LazyLock<Mutex<WindowTaps>> = LazyLock::new(Default::default);
+
+pub(super) fn window_key(key: u8, down: bool) {
+    WINDOW_TAPS.lock().unwrap_or_else(PoisonError::into_inner).change(key, down, Instant::now());
+}
+
+pub(super) fn clear_window_taps() {
+    WINDOW_TAPS.lock().unwrap_or_else(PoisonError::into_inner).0.clear();
+}
+
+#[test]
+fn window_taps_reach_the_next_frame_without_sticking() {
+    let now = Instant::now();
+    let mut taps = WindowTaps::default();
+    taps.change(0x0d, true, now);
+    taps.change(0x0d, false, now);
+    taps.change(b'P', true, now);
+    let mut down = vec![0x0d];
+    taps.add_active(now, &mut down);
+    assert_eq!(down, [0x0d]);
+    down.clear();
+    taps.add_active(now + Duration::from_millis(33), &mut down);
+    assert_eq!(down, [0x0d]);
+    down.clear();
+    let later = now + Duration::from_millis(66);
+    taps.add_active(later, &mut down);
+    assert!(down.is_empty());
+    taps.change(0x28, true, now);
+    taps.add_active(later, &mut down);
+    assert_eq!(down, [0x28]);
+    taps.change(0x28, false, later);
+    down.clear();
+    taps.add_active(later, &mut down);
+    assert!(down.is_empty());
+}
