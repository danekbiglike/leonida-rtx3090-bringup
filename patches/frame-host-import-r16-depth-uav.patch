+                print_cases(host_cases, who.c_str());
+                if (vk.host_pointer_alignment) failures += compare_cases(vulkan_cases, host_cases, who.c_str());
             }
         }
     }
diff --git a/runtime/test/d3d12_xbox_depth_uav_test.cpp b/runtime/test/d3d12_xbox_depth_uav_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d11e3b4198d69a8a1919828bd59fadc6f75a67e3
--- /dev/null
+++ b/runtime/test/d3d12_xbox_depth_uav_test.cpp
@@ -0,0 +1,145 @@
+// An Xbox typeless R16 texture as a depth attachment and storage image on Vulkan.
+#include "../shims/d3d12_com.h"
+#include "../shims/d3d12_xs_device.h"
+#include <wrl/client.h>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+using Microsoft::WRL::ComPtr;
+#define REQUIRE(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+namespace {
+constexpr UINT width = 32, height = 16, pitch = 256;
+constexpr UINT64 slice_bytes = height * pitch;
+
+void transition(ID3D12GraphicsCommandList* list, ID3D12Resource* texture, UINT slice,
+                D3D12_RESOURCE_STATES before, D3D12_RESOURCE_STATES after) {
+    D3D12_RESOURCE_BARRIER b{};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition = {texture, slice, before, after};
+    list->ResourceBarrier(1, &b);
+}
+
+void read_slice(ID3D12GraphicsCommandList* list, ID3D12Resource* texture, UINT slice, ID3D12Resource* rb, UINT sample) {
+    D3D12_TEXTURE_COPY_LOCATION dst{rb, D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT};
+    dst.PlacedFootprint = {slice_bytes * sample, {DXGI_FORMAT_D16_UNORM, width, height, 1, pitch}};
+    D3D12_TEXTURE_COPY_LOCATION src{texture, D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX};
+    src.SubresourceIndex = slice;
+    list->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+}
+}
+
+int main() {
+    ComPtr<ID3D12Device> device, proxy;
+    if (FAILED(rt::d3d12::create_vulkan_device_standalone(IID_PPV_ARGS(&device)))) return 77;
+    ComPtr<ID3D12Device> proxy_ref = device;
+    REQUIRE(SUCCEEDED(rt::d3d12_xs::create_device_proxy(proxy_ref.Get(), IID_PPV_ARGS(&proxy))));
+    proxy_ref.Detach();  // the proxy adopts this reference on success
+    using Placed = HRESULT(WINAPI*)(void*, UINT64, const D3D12_RESOURCE_DESC*, UINT, const D3D12_CLEAR_VALUE*,
+                                    const IID*, void**);
+    auto place = reinterpret_cast<Placed>((*reinterpret_cast<void***>(proxy.Get()))[133]);
+    D3D12_RESOURCE_DESC desc{};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width;
+    desc.Height = height;
+    desc.DepthOrArraySize = 2;
+    desc.MipLevels = desc.SampleDesc.Count = 1;
+    desc.Format = DXGI_FORMAT_R16_TYPELESS;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL | D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    D3D12_CLEAR_VALUE optimized{};
+    optimized.Format = DXGI_FORMAT_D16_UNORM;
+    optimized.DepthStencil.Depth = 1.0f;
+    const IID iid = __uuidof(ID3D12Resource);
+    ComPtr<ID3D12Resource> texture;
+    REQUIRE(SUCCEEDED(place(proxy.Get(), 0, &desc, D3D12_BARRIER_LAYOUT_UNORDERED_ACCESS, &optimized,
+                            &iid, reinterpret_cast<void**>(texture.GetAddressOf()))));
+    REQUIRE(texture->GetDesc().Flags == desc.Flags && rt::d3d12::xbox_depth_storage_peer(texture.Get()));
+
+    ComPtr<ID3D12DescriptorHeap> uavs, dsvs;
+    D3D12_DESCRIPTOR_HEAP_DESC hd{D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV, 2, D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE};
+    REQUIRE(SUCCEEDED(device->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&uavs))));
+    hd = {D3D12_DESCRIPTOR_HEAP_TYPE_DSV, 1, D3D12_DESCRIPTOR_HEAP_FLAG_NONE};
+    REQUIRE(SUCCEEDED(device->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&dsvs))));
+    D3D12_DEPTH_STENCIL_VIEW_DESC dsv{};
+    dsv.Format = DXGI_FORMAT_D16_UNORM;
+    dsv.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2DARRAY;
+    dsv.Texture2DArray.ArraySize = 1;
+    device->CreateDepthStencilView(texture.Get(), &dsv, dsvs->GetCPUDescriptorHandleForHeapStart());
+    D3D12_RESOURCE_DESC buffer{};
+    buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer.Width = 4 * slice_bytes;
+    buffer.Height = buffer.DepthOrArraySize = buffer.MipLevels = buffer.SampleDesc.Count = 1;
+    buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    const D3D12_HEAP_PROPERTIES readback_heap{D3D12_HEAP_TYPE_READBACK};
+    ComPtr<ID3D12Resource> readback;
+    REQUIRE(SUCCEEDED(device->CreateCommittedResource(&readback_heap, D3D12_HEAP_FLAG_NONE, &buffer,
+                        D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&readback))));
+    ComPtr<ID3D12CommandQueue> queue;
+    const D3D12_COMMAND_QUEUE_DESC qd{D3D12_COMMAND_LIST_TYPE_DIRECT};
+    REQUIRE(SUCCEEDED(device->CreateCommandQueue(&qd, IID_PPV_ARGS(&queue))));
+    ComPtr<ID3D12CommandAllocator> allocator;
+    REQUIRE(SUCCEEDED(device->CreateCommandAllocator(qd.Type, IID_PPV_ARGS(&allocator))));
+    ComPtr<ID3D12GraphicsCommandList7> list;
+    REQUIRE(SUCCEEDED(device->CreateCommandList(0, qd.Type, allocator.Get(), nullptr, IID_PPV_ARGS(&list))));
+    ID3D12DescriptorHeap* heaps[]{uavs.Get()};
+    list->SetDescriptorHeaps(1, heaps);
+    const UINT values[]{0xa5c3, 0x1357, 0xffff, 0x1357};
+    const UINT step = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    for (UINT layer = 0; layer < 2; ++layer) {
+        D3D12_UNORDERED_ACCESS_VIEW_DESC uav{};
+        uav.Format = DXGI_FORMAT_R16_UINT;
+        uav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2DARRAY;
+        uav.Texture2DArray.FirstArraySlice = layer;
+        uav.Texture2DArray.ArraySize = 1;
+        auto cpu = uavs->GetCPUDescriptorHandleForHeapStart();
+        auto gpu = uavs->GetGPUDescriptorHandleForHeapStart();
+        cpu.ptr += layer * step;
+        gpu.ptr += layer * step;
+        device->CreateUnorderedAccessView(texture.Get(), nullptr, &uav, cpu);
+        const UINT color[]{values[layer], 0, 0, 0};
+        list->ClearUnorderedAccessViewUint(gpu, cpu, texture.Get(), color, 0, nullptr);
+    }
+    transition(list.Get(), texture.Get(), D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES,
+               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    read_slice(list.Get(), texture.Get(), 0, readback.Get(), 0);
+    read_slice(list.Get(), texture.Get(), 1, readback.Get(), 1);
+    transition(list.Get(), texture.Get(), 0, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_DEPTH_WRITE);
+    list->ClearDepthStencilView(dsvs->GetCPUDescriptorHandleForHeapStart(), D3D12_CLEAR_FLAG_DEPTH, 1.f, 0, 0, nullptr);
+    D3D12_TEXTURE_BARRIER enhanced{};
+    enhanced.SyncBefore = D3D12_BARRIER_SYNC_DEPTH_STENCIL;
+    enhanced.SyncAfter = D3D12_BARRIER_SYNC_COMPUTE_SHADING;
+    enhanced.AccessBefore = D3D12_BARRIER_ACCESS_DEPTH_STENCIL_WRITE;
+    enhanced.AccessAfter = D3D12_BARRIER_ACCESS_UNORDERED_ACCESS;
+    enhanced.LayoutBefore = D3D12_BARRIER_LAYOUT_DEPTH_STENCIL_WRITE;
+    enhanced.LayoutAfter = D3D12_BARRIER_LAYOUT_UNORDERED_ACCESS;
+    enhanced.pResource = texture.Get();
+    enhanced.Subresources = {0, 1, 0, 1, 0, 1};
+    D3D12_BARRIER_GROUP group{D3D12_BARRIER_TYPE_TEXTURE, 1};
+    group.pTextureBarriers = &enhanced;
+    list->Barrier(1, &group);
+    transition(list.Get(), texture.Get(), 0, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    read_slice(list.Get(), texture.Get(), 0, readback.Get(), 2);
+    read_slice(list.Get(), texture.Get(), 1, readback.Get(), 3);
+    REQUIRE(SUCCEEDED(list->Close()));
+    ID3D12CommandList* lists[]{list.Get()};
+    queue->ExecuteCommandLists(1, lists);
+    REQUIRE(rt::d3d12::last_execute_result(queue.Get()) == leonida::ReplayResult::success);
+    ComPtr<ID3D12Fence> fence;
+    REQUIRE(SUCCEEDED(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&fence))));
+    REQUIRE(SUCCEEDED(queue->Signal(fence.Get(), 1)) && SUCCEEDED(fence->SetEventOnCompletion(1, nullptr)));
+    void* mapped = nullptr;
+    REQUIRE(SUCCEEDED(readback->Map(0, nullptr, &mapped)));
+    unsigned errors = 0;
+    for (UINT sample = 0; sample < 4; ++sample) {
+        for (UINT y = 0; y < height; ++y) for (UINT x = 0; x < width; ++x) {
+            std::uint16_t value;
+            std::memcpy(&value, static_cast<const char*>(mapped) + sample * slice_bytes + y * pitch + x * 2, 2);
+            if (value != values[sample] && errors++ < 4)
+                std::fprintf(stderr, "sample %u at %u,%u: got %04x expected %04x\n", sample, x, y, value, values[sample]);
+        }
+    }
+    readback->Unmap(0, nullptr);
+    std::printf("Xbox R16 depth/UAV: 2048 texels checked, %u mismatches\n", errors);
+    return errors ? 1 : 0;
+}
