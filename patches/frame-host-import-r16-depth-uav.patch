+    // A single-mip Xbox R16 depth/UAV array uses one depth image and one storage image. Copy only the
+    // affected layers when ownership crosses between depth/sampled operations and unordered access.
+    bool copy_depth_layer(leonida::ResourceId dst, leonida::ResourceId src, UINT subresource) {
+        if (subresource == D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES) return list_.copy_resource({dst, src});
+        const leonida::CopyLocation from{src, false, subresource};
+        const leonida::CopyLocation to{dst, false, subresource};
+        return list_.copy_texture({to, 0, 0, 0, from, false, {}});
+    }
+
+    bool transition_resource(const D3D12_RESOURCE_TRANSITION_BARRIER& b, D3D12_RESOURCE_BARRIER_FLAGS flags) {
+        const auto depth = resource_id(b.pResource);
+        auto* peer = xbox_depth_storage_peer(b.pResource);
+        const bool before = b.StateBefore == D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        const bool after = b.StateAfter == D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        const auto storage = peer ? resource_id(peer) : depth;
+        const auto src = before ? storage : depth;
+        const auto dst = after ? storage : depth;
+        if (src == dst) return list_.transition({src, b.Subresource, u(b.StateBefore), u(b.StateAfter)}, u(flags));
+        if (flags == D3D12_RESOURCE_BARRIER_FLAG_BEGIN_ONLY) return true;
+        if (flags != D3D12_RESOURCE_BARRIER_FLAG_NONE && flags != D3D12_RESOURCE_BARRIER_FLAG_END_ONLY) return false;
+        return list_.transition({src, b.Subresource, u(b.StateBefore), D3D12_RESOURCE_STATE_COPY_SOURCE}) &&
+               copy_depth_layer(dst, src, b.Subresource) &&
+               list_.transition({dst, b.Subresource, D3D12_RESOURCE_STATE_COPY_DEST, u(b.StateAfter)});
+    }
+
+    bool texture_barrier(ID3D12Resource* resource, leonida::TextureBarrier b) {
+        auto* peer = xbox_depth_storage_peer(resource);
+        if (!peer) return list_.barrier(b);
+        const auto is_storage = [](UINT layout) {
+            return layout == D3D12_BARRIER_LAYOUT_UNORDERED_ACCESS ||
+                   layout == D3D12_BARRIER_LAYOUT_DIRECT_QUEUE_UNORDERED_ACCESS ||
+                   layout == D3D12_BARRIER_LAYOUT_COMPUTE_QUEUE_UNORDERED_ACCESS;
+        };
+        const auto src = is_storage(b.layout_before) ? resource_id(peer) : b.resource;
+        const auto dst = is_storage(b.layout_after) ? resource_id(peer) : b.resource;
+        b.resource = dst;
+        if (src == dst || b.layout_before == u(D3D12_BARRIER_LAYOUT_UNDEFINED)) return list_.barrier(b);
+        if (b.flags & D3D12_TEXTURE_BARRIER_FLAG_DISCARD) {
+            b.layout_before = u(D3D12_BARRIER_LAYOUT_UNDEFINED);
+            b.access_before = u(D3D12_BARRIER_ACCESS_NO_ACCESS);
+            return list_.barrier(b);
+        }
+        if (b.sync_after == u(D3D12_BARRIER_SYNC_SPLIT)) return true;
+        auto from = b;
+        from.resource = src;
+        from.sync_after = D3D12_BARRIER_SYNC_COPY;
+        from.access_after = D3D12_BARRIER_ACCESS_COPY_SOURCE;
+        from.layout_after = D3D12_BARRIER_LAYOUT_COPY_SOURCE;
+        if (!list_.barrier(from)) return false;
+        const auto& r = b.range;
+        if (!r.mip_count) {
+            if (!copy_depth_layer(dst, src, r.index_or_first_mip)) return false;
+        } else {
+            const auto layers = resource->GetDesc().DepthOrArraySize;
+            if (r.index_or_first_mip || r.mip_count != 1 || r.first_plane || r.plane_count != 1 ||
+                !r.layer_count || r.first_layer >= layers || r.layer_count > layers - r.first_layer) return false;
+            for (UINT i = 0; i < r.layer_count; ++i)
+                if (!copy_depth_layer(dst, src, r.first_layer + i)) return false;
+        }
+        b.sync_before = D3D12_BARRIER_SYNC_COPY;
+        b.access_before = D3D12_BARRIER_ACCESS_COPY_DEST;
+        b.layout_before = D3D12_BARRIER_LAYOUT_COPY_DEST;
+        return list_.barrier(b);
+    }
