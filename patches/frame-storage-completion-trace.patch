+void test_startup_trace(Env& env) {
+    const fs::path path = env.root / L"dstorage-startup.jsonl";
+    const bool tracing = rt::startup_trace::open(path.c_str());
+    check(tracing, "start the DirectStorage trace");
+    if (!tracing) return;
+
+    auto* file = open(env, L"GAME:\\data\\b.bin");
+    auto* queue = make_queue(env, 0x80, false);
+    auto* status = make_status(env, 1);
+    std::vector<uint8_t> bytes(8);
+    const auto good = file_request(file, 0, bytes.data(), static_cast<uint32_t>(bytes.size()));
+    const auto bad = file_request(file, env.b.size(), bytes.data(), static_cast<uint32_t>(bytes.size()));
+    queue->EnqueueRequest(&good);
+    queue->EnqueueRequest(&bad);
+    queue->EnqueueStatus(status, 0);
+    queue->Submit();
+    queue->Close();
+    check_hr(status->GetHResult(0), E_DSTORAGE_END_OF_FILE, "trace leaves the read failure visible to the title");
+    check(std::equal(bytes.begin(), bytes.end(), env.b.begin()), "trace leaves the successful read intact");
+    status->Release();
+    queue->Release();
+    file->Release();
+    rt::startup_trace::close();
+
+    std::ifstream input(path, std::ios::binary);
+    const std::string trace{std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>()};
+    const auto opened = trace.find("\"phase\":\"open\",\"entry_type\":\"call\"");
+    const auto queued = trace.find("\"phase\":\"queued\",\"entry_type\":\"file_request\"");
+    const auto submitted = trace.find("\"phase\":\"submitted\",\"entry_type\":\"file_request\"");
+    const auto started = trace.find("\"phase\":\"started\",\"entry_type\":\"file_request\"");
+    const auto complete = trace.find("\"phase\":\"complete\",\"entry_type\":\"file_request\"");
+    const auto notified = trace.find("\"phase\":\"complete\",\"entry_type\":\"status\"");
+    check(opened < queued && queued < submitted && submitted < started && started < complete &&
+              complete < notified && notified != std::string::npos,
+          "trace follows a file open, enqueue, submit, worker start, read completion and status notification");
+    const std::string failure = "\"result\":" + std::to_string(static_cast<uint32_t>(E_DSTORAGE_END_OF_FILE));
+    check(trace.find(failure, notified) < trace.find('\n', notified), "trace records the HRESULT delivered to status");
+}
+
 }  // namespace
 
