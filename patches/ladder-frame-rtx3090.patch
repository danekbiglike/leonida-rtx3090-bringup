index e9b19b7a8607ee6d8511ab020ce7ed7ca3d93e2f..bca58b6b542d31d2b5d7929cb08dad3a77b8b527 100644
--- a/runtime/test/device_proxy_test.cpp
+++ b/runtime/test/device_proxy_test.cpp
@@ -16,6 +16,7 @@
 #include <d3dcompiler.h>
 #include <dxgi1_4.h>
 
+#include <cmath>
 #include <cstdint>
 #include <cstdio>
 #include <cstring>
