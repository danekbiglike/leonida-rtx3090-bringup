+    // Inspect only images from the local resource registry, after successful submission. The
+    // ordinary readback path handles staging and tracks image layouts for subsequent commands.
+    void sample_submitted_target(const leonida::TargetView& view, std::uint64_t draw) {
+        if (!context_.retain_color_target(view.resource)) return;
+        auto release = [](ID3D12Resource* r) { r->Release(); };
+        std::unique_ptr<ID3D12Resource, decltype(release)> target(reinterpret_cast<ID3D12Resource*>(view.resource), release);
+        const auto d = target->GetDesc();
+        if (d.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || view.mip >= d.MipLevels || view.mip >= 32 ||
+            view.first_layer >= d.DepthOrArraySize || d.SampleDesc.Count != 1 || !d.Width || !d.Height) return;
+        unsigned words = 1;
+        std::uint32_t masks[4]{};
+        switch (d.Format) {
+        case DXGI_FORMAT_R8G8B8A8_TYPELESS: case DXGI_FORMAT_R8G8B8A8_UNORM: case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+        case DXGI_FORMAT_B8G8R8A8_TYPELESS: case DXGI_FORMAT_B8G8R8A8_UNORM: case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+            masks[0] = 0x00ffffffu; break;
+        case DXGI_FORMAT_R10G10B10A2_TYPELESS: case DXGI_FORMAT_R10G10B10A2_UNORM:
+            masks[0] = 0x3fffffffu; break;
+        case DXGI_FORMAT_R11G11B10_FLOAT:
+            masks[0] = UINT32_MAX; break;
+        case DXGI_FORMAT_R16G16B16A16_FLOAT:
+            words = 2; masks[0] = 0x7fff7fffu; masks[1] = 0x7fffu; break;
+        case DXGI_FORMAT_R32G32B32A32_FLOAT:
+            words = 4; masks[0] = masks[1] = masks[2] = 0x7fffffffu; break;
+        default:
+            std::fprintf(stderr, "[frame-graph] readback unsupported format=%u id=%llx\n", unsigned(d.Format),
+                         static_cast<unsigned long long>(view.resource));
+            return;
+        }
+        const auto w = std::max<UINT64>(1, d.Width >> view.mip);
+        const auto h = std::max<UINT>(1, d.Height >> view.mip);
+        if (w > 16384 || h > 16384 || w * h * words > 33554432) return;
+        const auto count = static_cast<std::size_t>(w * h);
+        std::vector<std::uint32_t> pixels(count * words);
+        const UINT layer = view.first_layer * d.MipLevels + view.mip;
+        const HRESULT hr = target->ReadFromSubresource(pixels.data(), UINT(w * words * 4), UINT(count * words * 4), layer, nullptr);
+        std::size_t lit = 0;
+        if (SUCCEEDED(hr)) {
+            for (std::size_t i = 0; i < pixels.size(); i += words) {
+                std::uint32_t visible = 0;
+                for (unsigned j = 0; j < words; ++j) visible |= pixels[i + j] & masks[j];
+                if (visible) ++lit;
+            }
+        }
+        std::fprintf(stderr, "[frame-graph] after-draw=%llu target=%llx format=%u mip=%u layer=%u pixels=%zu nonblack=%zu hr=%08lx\n",
+                     static_cast<unsigned long long>(draw), static_cast<unsigned long long>(view.resource), unsigned(d.Format),
+                     view.mip, view.first_layer, count, lit, static_cast<unsigned long>(hr));
+    }
+
+    void observe_submission(const std::vector<const leonida::CommandList*>& recorded) {
+        static std::atomic_uint64_t batches{0}, draws{0};
+        const auto batch = ++batches;
+        if (batch > 4096) return;
+        for (const auto* list : recorded) for (const auto& command : list->commands()) {
+            if (const auto* draw = std::get_if<leonida::Draw>(&command)) {
+                if (!draw->views || !draw->views->render_target_count) continue;
+                const auto& target = draw->views->render_targets[0];
+                const auto n = ++draws;
+                if (n <= 2 || n == 8 || n == 32) sample_submitted_target(target, n);
+            } else if (const auto* copy = std::get_if<leonida::CopyResource>(&command)) {
+                std::fprintf(stderr, "[frame-graph] copy-resource %llx %llx\n",
+                             static_cast<unsigned long long>(copy->src), static_cast<unsigned long long>(copy->dst));
+            } else if (const auto* copy = std::get_if<leonida::CopyTexture>(&command)) {
+                std::fprintf(stderr, "[frame-graph] copy-texture %llx %llx\n",
+                             static_cast<unsigned long long>(copy->src.resource), static_cast<unsigned long long>(copy->dst.resource));
+            } else if (const auto* resolve = std::get_if<leonida::ResolveSubresource>(&command)) {
+                std::fprintf(stderr, "[frame-graph] resolve %llx %llx\n",
+                             static_cast<unsigned long long>(resolve->src), static_cast<unsigned long long>(resolve->dst));
+            } else if (const auto* clear = std::get_if<leonida::ClearRenderTarget>(&command)) {
+                std::fprintf(stderr, "[frame-graph] clear %llx\n", static_cast<unsigned long long>(clear->target.resource));
+            }
+        }
+    }
