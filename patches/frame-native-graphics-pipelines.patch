+// A bounded list of public container identifiers for matching a small local shader catalogue offline.
+// Reading a stage here is optional and independent of native pipeline creation.
+void observe_native_pipeline(const void* descriptor, HRESULT hr) {
+    namespace np = leonida::native_pso;
+    static std::atomic_uint64_t samples{0};
+    const auto number = ++samples;
+    if (number > 256 || !descriptor ||
+        !descriptor_memory_accessible(reinterpret_cast<SIZE_T>(descriptor), sizeof(np::GraphicsDesc), false)) return;
+    const auto& desc = *static_cast<const np::GraphicsDesc*>(descriptor);
+    std::string keys;
+    for (const auto& stage : desc.stages) {
+        const auto& pair = stage.records;
+        if (!pair.size) continue;
+        if (np::pair_state(pair) != np::PairState::present || pair.size > 65536 ||
+            !descriptor_memory_accessible(reinterpret_cast<SIZE_T>(pair.data), static_cast<SIZE_T>(pair.size), false))
+            return;
+        keys += " [";
+        for (const auto& digest : np::record_digests(np::bytes(pair))) {
+            if (keys.size() > 4096) return;
+            keys += np::hex(digest);
+            keys += ' ';
+        }
+        keys += ']';
+    }
+    std::fprintf(stderr, "[frame-graph] native-request=%llu hr=%08lx%s\n",
+                 static_cast<unsigned long long>(number), static_cast<unsigned long>(hr), keys.c_str());
